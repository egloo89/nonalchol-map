rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 가게 목록: 누구나 읽기/쓰기 가능
    // (관리자 페이지가 Firebase Auth 미사용 - 별도 비밀번호 보호)
    match /places/{docId} {
      allow read, write: if true;
    }

    // 제보: 누구나 생성 가능, 읽기·수정·삭제도 허용 (관리자 운영)
    match /reports/{docId} {
      allow read, write: if true;
    }

    // 유저 정보: 본인만 읽기/쓰기
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
