rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 가게 목록: 누구나 읽기/쓰기 가능
    // (관리자 페이지가 Firebase Auth 미사용 - 별도 비밀번호 보호)
    match /places/{docId} {
      allow read, write: if true;
    }

    // 제보: 누구나 생성 가능, 읽기·수정·삭제도 허용 (관리자 운영)
    match /reports/{docId} {
      allow read, write: if true;
    }

    // 일자별 방문자 통계 (문서 ID = 한국 날짜 YYYY-MM-DD)
    // 읽기: 관리자 페이지가 카카오/네이버 로그인(Firebase Auth 아님)으로도 열리므로 공개
    // 쓰기: 한 번에 pageviews +1, visitors +0 또는 +1 만 허용. 삭제·임의 수정 불가
    match /stats_daily/{day} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['pageviews', 'visitors'])
        && request.resource.data.pageviews == 1
        && request.resource.data.get('visitors', 0) in [0, 1];
      allow update: if request.resource.data.keys().hasOnly(['pageviews', 'visitors'])
        && request.resource.data.pageviews == resource.data.pageviews + 1
        && request.resource.data.get('visitors', 0) - resource.data.get('visitors', 0) in [0, 1];
      allow delete: if false;
    }

    // 유저 정보: 본인만 읽기/쓰기
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
